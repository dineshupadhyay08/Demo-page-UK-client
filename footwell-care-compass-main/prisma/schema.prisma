generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ConsultationMode {
  IN_CLINIC
  VIDEO
}

model PatientProfile {
  id           String        @id @default(uuid())
  email        String        @unique
  firstName    String
  lastName     String
  phone        String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Practitioner {
  id           String        @id @default(uuid())
  email        String        @unique
  displayName  String
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id               String                @id @default(uuid())
  treatmentName    String
  startsAt         DateTime
  durationMinutes  Int
  consultationMode ConsultationMode
  status           AppointmentStatus     @default(PENDING)
  patientNote      String?
  patientId        String
  practitionerId   String
  patient          PatientProfile        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  practitioner     Practitioner          @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  documents        AppointmentDocument[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([practitionerId, startsAt])
  @@index([patientId, startsAt])
  @@index([status, startsAt])
}

model AppointmentDocument {
  id            String      @id @default(uuid())
  appointmentId String
  storageKey    String      @unique
  originalName  String
  mimeType      String
  byteSize      Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}
